script_name Expansion Zerg Campaign Area Town
script_id ZARx

	start_areatown
	wait 1
	bld 1 hachirosk 180
	multi expansion_worker_start
	w_bldstart 1 hachirosk
	var Set try_expand_var 0 13
	w_bld 1 hachirosk
	multi count_expansion
	placeholder_count Local AtL|Jump 1 Group_Buildings expansion_normal 13
	var Ex|Jump skip_building_var 1 idle 13
	
	:expansion_normal
	call main_wait_900
	call request_larvosk
	call main_wait_300
	multi request_surkith
	call main_wait_300
	call main_wait_300
	multi request_spraith
	call main_wait_300
	call main_wait_300
	call request_larvosk
	call main_wait_300
	multi production_cycle
	var Ex|Wait build_done_var 1 13
	call main_wait_300
	multi build_order_expansion
	call main_wait_300
	call main_wait_300
	bring 13 AtL_W 1 othstol_oviform Loc.63 blank
	bld 1 nydus_cesiant 98
	wait 7200
	bld 2 nydus_cesiant 98
	goto idle
	
	:build_order_expansion
	bring 13 AtL_W 1 hachirosk|caphrolosk|gathtelosk|larvosk_cesiant Loc.63 blank
	var Ex|Jump pref_assault 1 build_assault_fin2 13
	var Ex|Jump pref_swarm 1 build_swarm_fin2 13
	var Ex|Jump pref_sunblot 1 build_sunblot_fin2 13
	goto build_general_fin2
	
	:build_general_fin2
	placeholder_count Local AtL|Jump 2 Group_Buildings blank 13
	call wHydrok
	call main_wait_450
	call wQuazrok
	call wLiivral
	call wIrol
	call main_wait_150
	call wMuthrok
	call main_wait_300
	call wZorkiz
	call main_wait_300
	call wGorgral
	call main_wait_300
	call main_wait_600
	call wOthstol
	call main_wait_300
	call wGathtelosk
	call main_wait_300
	call wUltrok
	call main_wait_300
	call wElthisth
	call main_wait_600
	call wVithrath
	call main_wait_600
	call wMatravil
	call wAlmakis
	call main_wait_1200
	call wGeszkath
	call main_wait_2400
	call wAlkaj
	stop
	
	:build_assault_fin2
	placeholder_count Local AtL|Jump 2 Group_Buildings blank 13
	call wIrol
	call main_wait_300
	call wCaphrolosk
	call wQuazrok
	call wLiivral
	call main_wait_300
	call wHachirosk
	call main_wait_150
	call wHydrok
	call wGorgral
	call main_wait_150
	call main_wait_300
	call wMuthrok
	call main_wait_600
	call wMatravil
	call wOthstol
	call main_wait_600
	call wZorkiz
	call main_wait_300
	call wGathtelosk
	call main_wait_300
	call wAlmakis
	call main_wait_300
	call wElthisth
	call main_wait_300
	call wUltrok
	call main_wait_900
	call wVithrath
	call main_wait_1200
	call wGeszkath
	call main_wait_2400
	call wAlkaj
	stop
	
	:build_swarm_fin2
	placeholder_count Local AtL|Jump 2 Group_Buildings blank 13
	call main_wait_150
	call wIrol
	call wMuthrok
	call main_wait_1200
	call wMatravil
	call main_wait_300
	call wHydrok
	call wGorgral
	call main_wait_600
	call wZorkiz
	call main_wait_150
	call wVithrath
	call main_wait_300
	call wOthstol
	call wGathtelosk
	call wAlmakis
	call main_wait_600
	call wElthisth
	wait 24
	call wUltrok
	call main_wait_600
	call wGeszkath
	call main_wait_2400
	call wAlkaj
	stop
	
	:build_sunblot_fin2
	placeholder_count Local AtL|Jump 2 Group_Buildings blank 13
	call wIrol
	call wQuazrok
	call wMuthrok
	call main_wait_300
	call wHydrok
	call wGorgral
	call main_wait_300
	call wVithrath
	call wLiivral
	call main_wait_900
	call wMatravil
	call main_wait_600
	call wOthstol
	call main_wait_300
	call wAlmakis
	call main_wait_150
	call wGathtelosk
	call main_wait_600
	call wGeszkath
	call main_wait_450
	call wZorkiz
	call main_wait_900
	call wUltrok
	call main_wait_600
	call wElthisth
	call main_wait_2400
	call wAlkaj
	stop
	
	:idle
	wait 25500
	goto idle
	
	:blank
	stop
	
	:blank_return
	return
	
	:count_expansion
	wait 12
	local 255 Ex 0 hachirosk|caphrolosk|gathtelosk count_expansion
	var Add town_count_var 1 13
	local 255 Ex_W 0 hachirosk|caphrolosk|gathtelosk blank
	var subtract town_count_var 1 13
	goto count_expansion
	
	:save_money_for_expansion
	wait 12
	time AtM 5760 Frames save_money_for_expansion # 5 minutes
	res 13 AtL Ore 350 save_money_for_expansion
	var Ex|Wait try_expand_var 1 13
	var Set can_build_static_defense_var 0 13
	var Set can_queue_early_military_var 0 13
	var Ex|Wait try_expand_var 0 13
	call build_bool
	goto save_money_for_expansion
	
	:expansion_worker_start
	wait 24
	local 255 Ex 0 hachirosk|caphrolosk|gathtelosk expansion_worker_start
	w_bld 1 hachirosk
	bld 3 droleth 98
	maynard 3
	multi worker_track
	
	:expansion_worker_standard_loop
	wait 12
	local 255 Ex 0 larva expansion_worker_standard_loop
	var AtL|WF(240) can_worker_all_var 1 13
	bring 13 AtL 4 hachirosk|caphrolosk|gathtelosk|larvosk_cesiant Loc.63 expansion_worker_standard_loop_maximum
	bring 13 AtL 3 hachirosk|caphrolosk|gathtelosk|larvosk_cesiant Loc.63 expansion_worker_standard_loop_medium
	wait 120
	local 255 AtL 12 droleth|gosvileth expansion_worker_standard_loop
	call worker_conditions
	local 255 AtL_W 1 larva blank
	c_queues train droleth|gosvileth 13
	queue 1 droleth larva 255 Local Loc.63 200
#	call main_worker_loop_gosvileth
	goto expansion_worker_standard_loop
	
	:expansion_worker_standard_loop_medium
	wait 120
	local 255 AtL 16 droleth|gosvileth expansion_worker_standard_loop
	res 13 AtL_W Ore 50 blank
	call worker_conditions
	local 255 AtL_W 1 larva blank
	c_queues train droleth|gosvileth 13
	queue 1 droleth larva 255 Local Loc.63 200
#	call main_worker_loop_gosvileth
	goto expansion_worker_standard_loop
	
	:expansion_worker_standard_loop_maximum
	wait 120
	local 255 AtL 24 droleth|gosvileth expansion_worker_standard_loop
	call worker_conditions
	local 255 AtL_W 1 larva blank
	c_queues train droleth|gosvileth 13
	queue 1 droleth larva 255 Local Loc.63 200
#	call main_worker_loop_gosvileth
	goto expansion_worker_standard_loop
	
	:worker_conditions
	wait 12
	bring 13 AtL 10 larva Loc.63 blank_return
	var Ex|WF(240) under_attack_var 0 13
	return
	
	:worker_track
	wait 120
	local 255 AtL_W 10 droleth|gosvileth blank
	var Add mining_count_var 1 13
	local 255 AtM_W 9 droleth|gosvileth blank
	var Sub mining_count_var 1 13
	goto worker_track
	
	:build_bool
	# These are used no matter what!
	var Add can_worker_var 1 13
	var Add can_expand_var 1 13
	var Set can_attack_var 1 13
	var Set build_gas_var 1 13
	var Set build_done_var 1 13
	# These are not used if skip_building_var is true!
	var Set can_build_static_defense_var 1 13
	var Set can_queue_early_military_var 1 13
	var Set can_build_production_var 1 13
	return
	
	:wIrol
	wait 12
	bring 13 AtL 1 irol_iris|irulent_ivoa|othstol_oviform|orboth_omlia Loc.63 wIrol
	multi need_irol
	return
	
	:need_irol
	wait 24
	bring 13 AtL 1 irol_iris|irulent_ivoa|othstol_oviform|orboth_omlia Loc.63 blank
	bring 13 AtM 3 larvosk_cesiant|hachirosk|caphrolosk|gathtelosk Loc.63 need_irol
	bring 13 Ex 0 quazrok_pool|liivral_pond|hydrok_den|gorgral_swamp|muthrok_spire|vithrath_haunt|zorkiz_shroud|ultrok_cavern|matravil_nest|almakis_antre|elthisth_mound|geszkath_grotto|alkaj_chasm Loc.63 need_irol
	bring 13 AtM 1 excisant Loc.63 need_irol
	call main_wait_450
	
	:need_irol2
	var Ex|Jump skip_building_var 1 blank_return 13
	p_need 1 irol_iris
	stop
	
	:wait_for_IrolIris
	wait 12
	bring 13 AtL 1 othstol_oviform|orboth_omlia Loc.63 blank_return
	notowns irol_iris wait_for_IrolIris
	return
	
	:need_irulent
	wait 24
	bring 13 AtL 1 irulent_ivoa|othstol_oviform|orboth_omlia Loc.63 blank
	notowns irol_iris need_irulent
	bring 13 AtM 4 larvosk_cesiant|hachirosk|caphrolosk|gathtelosk Loc.63 need_irulent
	bring 13 Ex 1 quazrok_pool|liivral_pond|hydrok_den|gorgral_swamp|muthrok_spire|vithrath_haunt|zorkiz_shroud|ultrok_cavern|matravil_nest|almakis_antre|elthisth_mound|geszkath_grotto|alkaj_chasm Loc.63 need_irulent
	bring 13 AtM 2 excisant Loc.63 need_irulent
	call main_wait_450
	
	:need_irulent2
	var Ex|Jump skip_building_var 1 blank_return 13
	p_need 1 irulent_ivoa
	stop
	
	:wait_for_IrulentIvoa
	wait 12
	notowns irulent_ivoa wait_for_IrulentIvoa
	return
	
	:wOthstol
	wait 12
	bring 13 AtL 1 othstol_oviform|orboth_omlia Loc.63 wOthstol
	multi need_othstol
	return
	
	:need_othstol
	wait 24
	bring 13 AtL 1 othstol_oviform|orboth_omlia Loc.63 blank
	bring 13 Ex 0 irol_iris|irulent_ivoa Loc.63 need_othstol
	bring 13 AtM 5 larvosk_cesiant|hachirosk|caphrolosk|gathtelosk Loc.63 need_othstol
	bring 13 Ex 2 quazrok_pool|liivral_pond|hydrok_den|gorgral_swamp|muthrok_spire|vithrath_haunt|zorkiz_shroud|ultrok_cavern|matravil_nest|almakis_antre|elthisth_mound|geszkath_grotto|alkaj_chasm Loc.63 need_othstol
	bring 13 AtM 4 excisant Loc.63 need_othstol
	call main_wait_450
	
	:need_othstol2
	var Ex|Jump skip_building_var 1 blank_return 13
	p_need 1 othstol_oviform
	stop
	
	:wait_for_OthstolOviform
	wait 12
	notowns othstol_oviform wait_for_OthstolOviform
	return
	
	:need_orboth
	wait 24
	bring 13 AtL 1 orboth_omlia Loc.63 blank
	notowns othstol_oviform need_orboth
	bring 13 AtM 7 larvosk_cesiant|hachirosk|caphrolosk|gathtelosk Loc.63 need_orboth
	bring 13 Ex 4 quazrok_pool|liivral_pond|hydrok_den|gorgral_swamp|muthrok_spire|vithrath_haunt|zorkiz_shroud|ultrok_cavern|matravil_nest|almakis_antre|elthisth_mound|geszkath_grotto|alkaj_chasm Loc.63 need_orboth
	bring 13 AtM 4 excisant Loc.63 need_orboth
	call main_wait_450
	
	:need_orboth2
