	:wait_for_OrbothOmlia
	wait 12
	notowns orboth_omlia wait_for_OrbothOmlia
	return
	
	:wait_for_QuazrokPool
	wait 12
	bring 13 AtL 1 liivral_pond Loc.63 blank_return
	notowns quazrok_pool wait_for_QuazrokPool
	return
	
	:wait_for_HydrokDen
	wait 12
	bring 13 AtL 1 gorgral_swamp Loc.63 blank_return
	notowns hydrok_den wait_for_HydrokDen
	return
	
	:wait_for_ZorkizShroud
	wait 12
	bring 13 AtL 1 ultrok_cavern Loc.63 blank_return
	notowns zorkiz_shroud wait_for_ZorkizShroud
	return
	
	:wait_for_MuthrokSpire
	wait 12
	bring 13 AtL 1 vithrath_haunt Loc.63 blank_return
	notowns muthrok_spire wait_for_MuthrokSpire
	return
	
	:request_larvosk
	var AtL|wait town_count_var 1 13
	wait 12
	bring 13 Ex 0 droleth|gosvileth Loc.63 request_larvosk
	add_bld 255 larvosk_cesiant 1 10 109
	return
	
	:wHachirosk
	var AtL|wait town_count_var 1 13
	wait 12
	bring 13 Ex 0 droleth|gosvileth Loc.63 wHachirosk
	res 13 AtM Ore 199 wHachirosk
	add_bld 255 hachirosk 1 99 96
	return
	
	:wCaphrolosk
	wait 12
	bring 13 Ex 0 irol_iris|irulent_ivoa|othstol_oviform|orboth_omlia Loc.63 wCaphrolosk
	notowns hachirosk wCaphrolosk
	add_bld 255 caphrolosk 1 99 97
	return
	
	:wGathtelosk
	wait 12
	bring 13 Ex 0 othstol_oviform|orboth_omlia Loc.63 wGathtelosk
	notowns caphrolosk wGathtelosk
	add_bld 255 gathtelosk 1 99 98
	return
	
