	return
	
	:wElthisth
	wait 12
	bring 13 Ex 0 orboth_omlia Loc.63 wElthisth
	bring 13 AtL 1 elthisth_mound Loc.63 blank_return
	p_need 1 elthisth_mound
	return
	
	:request_surkith
	var Ex|Wait can_build_static_defense_var 1 13
	wait 90
	call main_wait_150
	var Ex|Wait can_build_static_defense_var 1 13
	add_bld 255 surkith_cesiant 1 5 106
	wait 450
	
	:request_surkith_loop
	var Ex|Wait can_build_static_defense_var 1 13
	wait 12
	local 255 Ex 0 hachirosk|caphrolosk|gathtelosk request_surkith_loop
	bring 13 Ex 0 droleth|gosvileth Loc.63 request_surkith_loop
	bring 13 AtL 1 cagrant_cesiant Loc.63 request_surkith_loop
	res 13 AtL_C Ore 125 request_surkith_check
	wait 90
	call main_wait_150
	goto request_surkith_loop
	
	:request_surkith_check
	local 255 AtL 5 surkith_cesiant request_surkith_check_2
	add_bld 255 surkith_cesiant 1 5 106
	var Ex|Jump under_attack_by_ground_var 1 add_return_wait_960 13
	goto add_return_wait_1440
	
	:request_surkith_check_2
	var Ex|Jump under_attack_by_ground_var 1 request_surkith_check_3 13
	var AtM|Jump mining_count_var 2 add_return_wait_960 13
	add_bld 255 surkith_cesiant 1 7 106
	goto add_return_wait_960
	
	:request_surkith_check_3
	add_bld 255 surkith_cesiant 1 10 106
	goto add_return_wait_960
	
	:request_spraith
	var Ex|Wait can_build_static_defense_var 1 13
	wait 90
	call main_wait_150
	var Ex|Wait can_build_static_defense_var 1 13
	add_bld 255 spraith_cesiant 1 5 106
	wait 450
	
	:request_spraith_loop
	var Ex|Wait can_build_static_defense_var 1 13
	wait 12
	local 255 Ex 0 hachirosk|caphrolosk|gathtelosk request_spraith_loop
	bring 13 Ex 0 droleth|gosvileth Loc.63 request_spraith_loop
	bring 13 AtL 1 cagrant_cesiant Loc.63 request_spraith_loop
	res 13 AtL_C Ore 125 request_spraith_check
	wait 60
	call main_wait_300
	goto request_spraith_loop
	
	:request_spraith_check
	local 255 AtL 3 spraith_cesiant request_spraith_check_2
	add_bld 255 spraith_cesiant 1 10 106
	var Ex|Jump under_attack_by_air_var 1 add_return_wait_960 13
	goto add_return_wait_1440
	
	:request_spraith_check_2
	var Ex|Jump under_attack_by_air_var 1 request_spraith_check_3 13
	var AtM|Jump mining_count_var 2 add_return_wait_960 13
	add_bld 255 spraith_cesiant 1 7 106
	goto add_return_wait_960
	
	:request_spraith_check_3
	add_bld 255 spraith_cesiant 1 10 106
	goto add_return_wait_960
	
	:production_cycle
	var Set can_build_production_var 1 13
	
	:production_cycle_conditions
	wait 24
	var Ex|Jump mining_count_var 0 production_cycle_conditions 13
	local 255 Ex 0 hachirosk|caphrolosk|gathtelosk production_cycle_conditions
	local 255 AtM 4 droleth|gosvileth production_cycle_conditions
	bring 13 AtL 10 larva Loc.63 production_cycle_conditions
	bring 13 Ex 0 irol_iris|othstol_oviform Loc.63 production_cycle_conditions
	bring 13 AtL 26 Group_Factories Loc.63 production_cycle_conditions_6
	bring 13 AtL 21 Group_Factories Loc.63 production_cycle_conditions_5
	bring 13 AtL 16 Group_Factories Loc.63 production_cycle_conditions_4
	bring 13 AtL 11 Group_Factories Loc.63 production_cycle_conditions_3
	bring 13 AtL 7 Group_Factories Loc.63 production_cycle_conditions_2
	goto production_cycle_loop
	
	:production_cycle_conditions_2
	bring 13 Ex 0 irol_iris|othstol_oviform Loc.63 production_cycle_conditions
	var Ex|Jump mining_count_var 1 production_cycle_conditions 13
	goto production_cycle_loop
	
	:production_cycle_conditions_3
	var Ex|Jump mining_count_var 2 production_cycle_conditions 13
	goto production_cycle_loop
	
	:production_cycle_conditions_4
	bring 13 Ex 0 othstol_oviform Loc.63 production_cycle_conditions
	var Ex|Jump mining_count_var 3 production_cycle_conditions 13
	goto production_cycle_loop
	
	:production_cycle_conditions_5
	var Ex|Jump mining_count_var 4 production_cycle_conditions 13
	goto production_cycle_loop
	
	:production_cycle_conditions_6
	var Ex|Jump mining_count_var 5 production_cycle_conditions 13
	goto production_cycle_loop
	
	:production_cycle_loop
	wait 12
	var AtL|Call prod_cycle_var 1 production_cycle_wait 13
	var Set prod_cycle_var 0 13
	var Ex|Wait can_build_production_var 1 13
	call production_cycle_check
	wait 60
	goto production_cycle_conditions
	
	:production_cycle_wait
	call main_wait_150
	var AtL|Jump mining_count_var 5 blank_return 13
	call main_wait_150
	var AtL|Jump mining_count_var 4 blank_return 13
	call main_wait_150
	var AtL|Jump mining_count_var 3 blank_return 13
	call main_wait_150
	var AtL|Jump mining_count_var 2 blank_return 13
	call main_wait_150
	var AtL|Jump mining_count_var 1 blank_return 13
	return
	
	:production_cycle_check
	var Ex|Call prefLarvoskcesiant 1 production_larvosk_cesiant 13
	var Ex|Call prefHachirosk 1 production_hachirosk 13
	var Ex|Call prefCaphrolosk 1 production_caphrolosk 13
	var Ex|Call prefGathtelosk 1 production_gathtelosk 13
	var AtL|Call mining_count_var 5 production_gathtelosk 13
	var AtL|Call mining_count_var 3 production_caphrolosk 13
	res 13 AtL_C Any 500 production_hachirosk
	call production_larvosk_cesiant
	call production_hachirosk
	call production_caphrolosk
	call production_gathtelosk
	return
	
	:production_larvosk_cesiant
	wait 12
	var AtL|Jump prod_cycle_var 1 blank_return 13
	bring 13 Ex 0 droleth|gosvileth Loc.63 blank_return
	bring 13 AtL 1 cagrant_cesiant Loc.63 blank_return
	local 255 AtL 30 larvosk_cesiant blank_return
	add_bld 255 larvosk_cesiant 1 30 100
	call add_return_wait_960
	goto production_cycle_success
	
	:production_hachirosk
	wait 12
	var AtL|Jump prod_cycle_var 1 blank_return 13
	bring 13 Ex 0 droleth|gosvileth Loc.63 blank_return
	local 255 AtL 20 hachirosk|caphrolosk|gathtelosk blank_return
	add_bld 255 hachirosk 1 20 97
	call add_return_wait_1440
	goto production_cycle_success
	
	:production_caphrolosk
	wait 12
	var AtL|Jump prod_cycle_var 1 blank_return 13
	bring 13 Ex 0 droleth|gosvileth Loc.63 blank_return
	bring 13 Ex 0 irol_iris|irulent_ivoa|othstol_oviform|orboth_omlia Loc.63 blank_return
	local 255 AtL 20 hachirosk|caphrolosk|gathtelosk blank_return
	add_bld 255 hachirosk 1 20 98
	add_bld 255 caphrolosk 1 20 98
	call add_return_wait_1440
	goto production_cycle_success
	
	:production_gathtelosk
	wait 12
	var AtL|Jump prod_cycle_var 1 blank_return 13
