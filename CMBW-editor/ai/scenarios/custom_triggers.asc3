	dth 0 Ex_W 0 left_pit_door blank
	dth 0 Set 7 left_pit_door blank
	stop
	
	:triggers_OneForTheFuture_WallStreetWar_Scene8
	kills 18 3 AtL_W 1 nexus blank
	bring 3 Ex 0 nexus Loc.63 blank
	dth 0 Ex_W 0 left_pit_door blank
	dth 0 Set 8 left_pit_door blank
	stop
	
	:triggers_OneForTheFuture_WallStreetWar_Scene9
	kills 2 0 AtL_W 1 command_center blank
	bring 0 Ex 0 command_center Loc.63 blank
	dth 0 Ex_W 0 left_pit_door blank
	dth 0 Set 9 left_pit_door blank
	stop
	
	:triggers_OneForTheFuture_WallStreetWar_Scene10
	kills 3 0 AtL_W 1 command_center blank
	bring 0 Ex 0 command_center Loc.63 blank
	dth 0 Ex_W 0 left_pit_door blank
	dth 0 Set 10 left_pit_door blank
	stop
	
	:triggers_OneForTheFuture_WallStreetWar_Scene15
	var Ex|Wait defeatWallStreetWar 1 13
	var Ex|Jump defeatWallStreetWarDone 1 blank 13
	var Ex|Jump WallStreetWar_BorisCombat 0 blank 13
	dth 0 Ex_W 0 left_pit_door blank
	dth 0 Set 15 left_pit_door blank
	var Set defeatWallStreetWarDone 1 13
	stop
	
	:triggers_OneForTheFuture_WallStreetWar_Scene16
	var Ex|Wait defeatWallStreetWar 1 13
	var Ex|Jump defeatWallStreetWarDone 1 blank 13
	var Ex|Jump WallStreetWar_CarlCombat 0 blank 13
	dth 0 Ex_W 0 left_pit_door blank
	dth 0 Set 16 left_pit_door blank
	var Set defeatWallStreetWarDone 1 13
	stop
	
	:triggers_OneForTheFuture_WallStreetWar_Scene17
	var Ex|Wait defeatWallStreetWar 1 13
	var Ex|Jump defeatWallStreetWarDone 1 blank 13
	var Ex|Jump WallStreetWar_UllenCombat 0 blank 13
	dth 0 Ex_W 0 left_pit_door blank
	dth 0 Set 17 left_pit_door blank
	var Set defeatWallStreetWarDone 1 13
	stop
	
	:triggers_OneForTheFuture_WallStreetWar_Scene15Cond
	var Ex|Jump defeatWallStreetWarDone 1 blank 13
	wait 24
	player_combat 2 0 63 True Wait Any Any
	var Set WallStreetWar_BorisCombat 1 13
	var Set WallStreetWar_CarlCombat 0 13
	var Set WallStreetWar_UllenCombat 0 13
	goto triggers_OneForTheFuture_WallStreetWar_Scene15Cond
	
	:triggers_OneForTheFuture_WallStreetWar_Scene16Cond
	var Ex|Jump defeatWallStreetWarDone 1 blank 13
	wait 24
	player_combat 3 0 63 True Wait Any Any
	var Set WallStreetWar_BorisCombat 0 13
	var Set WallStreetWar_CarlCombat 1 13
	var Set WallStreetWar_UllenCombat 0 13
	goto triggers_OneForTheFuture_WallStreetWar_Scene16Cond
	
	:triggers_OneForTheFuture_WallStreetWar_Scene17Cond
	var Ex|Jump defeatWallStreetWarDone 1 blank 13
	wait 24
	player_combat 4 0 63 True Wait Any Any
	var Set WallStreetWar_BorisCombat 0 13
	var Set WallStreetWar_CarlCombat 0 13
	var Set WallStreetWar_UllenCombat 1 13
	goto triggers_OneForTheFuture_WallStreetWar_Scene17Cond
	
	:triggers_OneForTheFuture_WallStreetWar_TrackDefeat
	bring 0 Ex_W 0 command_center|Group_Factories Loc.63 blank
	var Set defeatWallStreetWar 1 13
	stop
	
