#####
	
	:triggers_TheLostGods_Cellbound
	wait 1
	multi triggers_TheLostGods_Cellbound_Scene2 # First contact w/ Terim Zerg
	multi triggers_TheLostGods_Cellbound_Scene3 # First contact w/ Terim Protoss
	multi triggers_TheLostGods_Cellbound_Scene4 # First contact w/ Joran Terran
	wait 1
	multi triggers_TheLostGods_Cellbound_Scene5 # Eliminate a Terim Zerg expansion
	multi triggers_TheLostGods_Cellbound_Scene6 # Eliminate a Terim Protoss expansion
	multi triggers_TheLostGods_Cellbound_Scene7 # Eliminate a Joran Terran expansion
	wait 1
	multi triggers_TheLostGods_Cellbound_Scene8 # Lose an expansion to Terim Zerg
	multi triggers_TheLostGods_Cellbound_Scene9 # Lose an expansion to Terim Protoss
	multi triggers_TheLostGods_Cellbound_Scene10 # Lose an expansion to Joran Terran
	wait 1
	multi triggers_TheLostGods_Cellbound_Scene11 # Slay 100 of Terim's Zerg
	multi triggers_TheLostGods_Cellbound_Scene12 # Slay 100 of Terim's Protoss
	multi triggers_TheLostGods_Cellbound_Scene13 # Slay 100 of Joran's Terrans
	wait 1
	multi triggers_TheLostGods_Cellbound_Scene14 # Lose 100 to Terim's Zerg
	multi triggers_TheLostGods_Cellbound_Scene15 # Lose 100 to Terim's Protoss
	multi triggers_TheLostGods_Cellbound_Scene16 # Lose 100 to Joran's Terrans
	wait 1
	multi triggers_TheLostGods_Cellbound_Scene17 # Kiraxxar defeats Terim's Zerg
	multi triggers_TheLostGods_Cellbound_Scene18 # Joran defeats Terim's Protoss
	multi triggers_TheLostGods_Cellbound_Scene19 # Kiraxxar defeats Terim's Protoss
	multi triggers_TheLostGods_Cellbound_Scene20 # Joran defeats Terim's Protoss
	wait 1
	multi triggers_TheLostGods_Cellbound_Scene17Cond
	multi triggers_TheLostGods_Cellbound_Scene18Cond
	multi triggers_TheLostGods_Cellbound_Scene19Cond
	multi triggers_TheLostGods_Cellbound_Scene20Cond
	wait 1
	multi triggers_TheLostGods_Cellbound_Scene21 # Kiraxxar defeats Joran
	multi triggers_TheLostGods_Cellbound_Scene22 # Terim's Zerg defeat Joran
	multi triggers_TheLostGods_Cellbound_Scene23 # Terim's Protoss defeat Joran
	wait 1
	multi triggers_TheLostGods_Cellbound_Scene21Cond
	multi triggers_TheLostGods_Cellbound_Scene22Cond
