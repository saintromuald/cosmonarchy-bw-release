	wait 1
	multi triggers_OneForTheFuture_AutisticYears_DefeatLightenedRealities
	multi triggers_OneForTheFuture_AutisticYears_DefeatAchromaticHalfdreams
	multi triggers_OneForTheFuture_AutisticYears_DefeatDarkenedFantasies
	# Handled through normal triggers
#	multi triggers_OneForTheFuture_AutisticYears_Scene1 # Intro
#	multi triggers_OneForTheFuture_AutisticYears_Scene18 # Victory
	stop
	
