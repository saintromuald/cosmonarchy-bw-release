	multi triggers_OneForTheFuture_AutisticYears_Scene12Cond
	multi triggers_OneForTheFuture_AutisticYears_Scene13Cond
	wait 1
	multi triggers_OneForTheFuture_AutisticYears_Scene14 # LightenedRealities defeats AchromaticHalfdreams
	multi triggers_OneForTheFuture_AutisticYears_Scene15 # AchromaticHalfdreams defeats LightenedRealities
	wait 1
	multi triggers_OneForTheFuture_AutisticYears_Scene14Cond
	multi triggers_OneForTheFuture_AutisticYears_Scene15Cond
	wait 1
	multi triggers_OneForTheFuture_AutisticYears_Scene16 # Lose to LightenedRealities
