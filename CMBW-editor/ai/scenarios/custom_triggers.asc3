	:triggers_OneForTheFuture_TheLostHandOfGod
	wait 1
	multi triggers_OneForTheFuture_TheLostHandOfGod_Scene2A # First contact with the StarEdit Crusaders
	multi triggers_OneForTheFuture_TheLostHandOfGod_Scene2B
	wait 1
	multi triggers_OneForTheFuture_TheLostHandOfGod_Scene3A # First contact with the Oscilliant Serfs
	multi triggers_OneForTheFuture_TheLostHandOfGod_Scene3B
	wait 1
	multi triggers_OneForTheFuture_TheLostHandOfGod_Scene5A # Destroy a StarEdit Crusader expansion
	multi triggers_OneForTheFuture_TheLostHandOfGod_Scene5B
	wait 1
	multi triggers_OneForTheFuture_TheLostHandOfGod_Scene6A # Destroy an Oscilliant expansion
	multi triggers_OneForTheFuture_TheLostHandOfGod_Scene6B
	wait 1
	multi triggers_OneForTheFuture_TheLostHandOfGod_Scene7A # Lose an expansion to the StarEdit Crusaders
	multi triggers_OneForTheFuture_TheLostHandOfGod_Scene7B
	wait 1
	multi triggers_OneForTheFuture_TheLostHandOfGod_Scene8A # Lose an expansion to LightenedRealities
	multi triggers_OneForTheFuture_TheLostHandOfGod_Scene8B
	wait 1
	# Handled through normal triggers
#	multi triggers_OneForTheFuture_TheLostHandOfGod_Scene4 # Veeq7 starts expanding
#	multi triggers_OneForTheFuture_TheLostHandOfGod_Scene9 # Defeat StarEdit Crusaders
#	multi triggers_OneForTheFuture_TheLostHandOfGod_Scene10 # Defeat LightenedRealities
#	multi triggers_OneForTheFuture_TheLostHandOfGod_Scene11 # Lose Veeq7
#	multi triggers_OneForTheFuture_TheLostHandOfGod_Scene12 # Lose knightoftherealm (defeat)
#	multi triggers_OneForTheFuture_TheLostHandOfGod_Scene13 # Victory
	stop
	
