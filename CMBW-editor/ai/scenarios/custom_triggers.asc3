script_name Terran 5 - Terran Main Town
script_id Ter5
# Custom triggers

	wait 1
	dth 13 Ex 2 scanner_sweep triggers_OneForTheFuture
	dth 13 Ex 3 scanner_sweep triggers_TheLostGods
	dth 13 Ex 4 scanner_sweep triggers_TheDeepestDream
	stop
	
	:blank
	stop
	
	:triggers_OneForTheFuture
	dth 13 Ex 1 right_pit_door triggers_OneForTheFuture_WallStreetWar
	dth 13 Ex 2 right_pit_door triggers_OneForTheFuture_TheLostHandOfGod
	dth 13 Ex 3 right_pit_door triggers_OneForTheFuture_AutisticYears
	dth 13 Ex 4 right_pit_door triggers_OneForTheFuture_PastaMasta
	dth 13 Ex 5 right_pit_door triggers_OneForTheFuture_ThreeHongKong
	dth 13 Ex 6 right_pit_door triggers_OneForTheFuture_SeventhCue
	dth 13 Ex 7 right_pit_door triggers_OneForTheFuture_FavoredFiction
	dth 13 Ex 8 right_pit_door triggers_OneForTheFuture_TheShitflingSinners
	dth 13 Ex 9 right_pit_door triggers_OneForTheFuture_TheCosmonarch
	stop
	
#####
	
	:triggers_OneForTheFuture_WallStreetWar
	wait 1
	multi triggers_OneForTheFuture_WallStreetWar_Scene3A # First contact w/ 1%
	multi triggers_OneForTheFuture_WallStreetWar_Scene3B # First contact w/ 1%
	wait 1
	multi triggers_OneForTheFuture_WallStreetWar_Scene4 # Destroy a Ullen expansion
	multi triggers_OneForTheFuture_WallStreetWar_Scene5 # Lose an expansion to Ullen
	wait 1
	multi triggers_OneForTheFuture_WallStreetWar_Scene6A # First contact w/ Crypto Miners
	multi triggers_OneForTheFuture_WallStreetWar_Scene6B # First contact w/ Crypto Miners
	wait 1
	multi triggers_OneForTheFuture_WallStreetWar_Scene7 # Destroy a Boris expansion
	multi triggers_OneForTheFuture_WallStreetWar_Scene8 # Destroy a Carl expansion
	wait 1
	multi triggers_OneForTheFuture_WallStreetWar_Scene9 # Lose an expansion to Boris
	multi triggers_OneForTheFuture_WallStreetWar_Scene10 # Lose an expansion to Carl
	wait 1
	multi triggers_OneForTheFuture_WallStreetWar_Scene15Cond
	multi triggers_OneForTheFuture_WallStreetWar_Scene15 # Lose to Boris
	wait 1
	multi triggers_OneForTheFuture_WallStreetWar_Scene16Cond
	multi triggers_OneForTheFuture_WallStreetWar_Scene16 # Lose to Carl
	wait 1
	multi triggers_OneForTheFuture_WallStreetWar_Scene17Cond
	multi triggers_OneForTheFuture_WallStreetWar_Scene17 # Lose to Ullen
	wait 1
	multi triggers_OneForTheFuture_WallStreetWar_TrackDefeat
	stop
	
	:triggers_OneForTheFuture_WallStreetWar_Scene3A
	player_combat 18 4 63 True Wait Any Any
	dth 0 Ex_W 0 left_pit_door blank
	var Ex|Jump WallStreetWar_Scene3 1 blank 13
	var Set WallStreetWar_Scene3 1 13
	dth 0 Set 3 left_pit_door blank
	stop
	
	:triggers_OneForTheFuture_WallStreetWar_Scene3B
	player_combat 4 18 63 True Wait Any Any
	dth 0 Ex_W 0 left_pit_door blank
	var Ex|Jump WallStreetWar_Scene3 1 blank 13
	var Set WallStreetWar_Scene3 1 13
	dth 0 Set 3 left_pit_door blank
	stop
	
	:triggers_OneForTheFuture_WallStreetWar_Scene4
	kills 18 4 AtL_W 1 command_center blank
	bring 13 Ex 0 command_center Loc.63 blank
	dth 0 Ex_W 0 left_pit_door blank
	dth 0 Set 4 left_pit_door blank
	stop
	
	:triggers_OneForTheFuture_WallStreetWar_Scene5
	kills 4 0 AtL_W 1 command_center blank
	bring 0 Ex 0 command_center Loc.63 blank
	dth 0 Ex_W 0 left_pit_door blank
	dth 0 Set 5 left_pit_door blank
	stop
	
