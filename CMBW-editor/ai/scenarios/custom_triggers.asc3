	:triggers_OneForTheFuture_AutisticYears
	wait 1
	multi triggers_OneForTheFuture_AutisticYears_Scene2A # First contact with LightenedRealities
	multi triggers_OneForTheFuture_AutisticYears_Scene2B
	wait 1
	multi triggers_OneForTheFuture_AutisticYears_Scene3A # First contact with AchromaticHalfdreams
	multi triggers_OneForTheFuture_AutisticYears_Scene3B
	wait 1
	multi triggers_OneForTheFuture_AutisticYears_Scene4 # Destroy a LightenedRealities expansion
	multi triggers_OneForTheFuture_AutisticYears_Scene5 # Destroy an AchromaticHalfdreams expansion
	wait 1
	multi triggers_OneForTheFuture_AutisticYears_Scene6 # Lose an expansion to LightenedRealities
	multi triggers_OneForTheFuture_AutisticYears_Scene7 # Lose an expansion to AchromaticHalfdreams
	wait 1
	multi triggers_OneForTheFuture_AutisticYears_Scene8 # Kill 100 LightenedRealities units
	multi triggers_OneForTheFuture_AutisticYears_Scene9 # Kill 100 AchromaticHalfdreams units
	wait 1
	multi triggers_OneForTheFuture_AutisticYears_Scene10 # Lose 100 units to LightenedRealities
	multi triggers_OneForTheFuture_AutisticYears_Scene11 # Lose 100 units to AchromaticHalfdreams
	wait 1
	multi triggers_OneForTheFuture_AutisticYears_Scene12 # Defeat LightenedRealities
	multi triggers_OneForTheFuture_AutisticYears_Scene13 # Defeat AchromaticHalfdreams
