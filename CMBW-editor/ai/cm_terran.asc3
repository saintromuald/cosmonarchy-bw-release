	:early_military
	var Ex|Jump skip_building_var 1 blank 13
	var Ex|Jump pref_armor 1 early_military_armor 13
	var Ex|Jump pref_raider 1 early_military_raider 13
	var Ex|Jump pref_orbital 1 early_military_orbital 13
	
	:early_military_general
	time AtL 7200 Frames blank
	var Ex|Wait can_queue_early_military_var 1 13
	bring 13 AtL_M 1 barracks Loc.63 early_maverick
	bring 13 AtL_M 1 machine_shop Loc.63 early_phalanx
	bring 13 AtL_M 1 starpad Loc.63 early_wraith
	bring 13 AtL_M 1 barracks Loc.63 early_cyprian
	bring 13 AtL_M 1 machine_shop Loc.63 early_goliath
	wait 480
	c_queues train maverick|phalanx|wraith|cyprian|goliath 13
	goto early_military_general
	
	:early_military_armor
	time AtL 7200 Frames blank
	var Ex|Wait can_queue_early_military_var 1 13
	bring 13 AtL_M 1 machine_shop Loc.63 early_phalanx
