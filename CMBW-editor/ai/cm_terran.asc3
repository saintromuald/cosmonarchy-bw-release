	goto attack_handling_standard
	
	:custom_scale_TheShitflingSinners
	dth 13 Ex 3 t_tank_turret custom_scale_TheShitflingSinners_CustomerSupporter
	dth 13 Ex 7 t_tank_turret tLoopA
	dth 13 Ex 8 t_tank_turret tLoopA
	goto attack_handling_standard
	
	:custom_scale_TheShitflingSinners_CustomerSupporter
	multi custom_scale_TheShitflingSinners_CustomerSupporter_Cond1
	multi custom_scale_TheShitflingSinners_CustomerSupporter_Cond2
	multi custom_scale_TheShitflingSinners_CustomerSupporter_Cond3
	var Ex|Wait custom_scale_TheShitflingSinners_CustomerSupporter_Signal 1 13
	goto tLoopA
	
	:custom_scale_TheShitflingSinners_CustomerSupporter_Cond1
	player_combat 18 13 63 True Wait Any Any
	var AtL|Jump custom_scale_TheShitflingSinners_CustomerSupporter_Signal 1 blank 13
	var Add custom_scale_TheShitflingSinners_CustomerSupporter_Signal 1 13
	stop
	
