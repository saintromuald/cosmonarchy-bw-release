	unit_check 13 13 63 Greater|Jump 0 0 fulcrum|mantle|iron_foundry barracks|captaincy|apothecary|starpad|starport|nanite_assembly add_attack_wave_armor 13
	unit_check 13 13 63 Greater|Jump 0 0 starpad|starport|nanite_assembly barracks|captaincy|apothecary|fulcrum|mantle|iron_foundry add_attack_wave_orbital 13
	rand_j 85 add_attack_wave_armor
	rand_j 128 add_attack_wave_raider
	goto add_attack_wave_orbital
	
