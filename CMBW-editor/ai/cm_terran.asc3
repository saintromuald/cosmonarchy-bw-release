	:preference_cycle_start
	var Ex|Wait build_done_var 1 13
	
	:pref_cycle
	wait 360
	
	:pref_cycle_raider
	var Ex|Jump pref_raider_production 1 pref_cycle_armor 13
	var AtL|Call mining_count_var 2 resetpref_armor_production_captaincy 13
	var AtM|Call mining_count_var 1 resetpref_armor_production_barracks 13
	
	:pref_cycle_armor
	var Ex|Jump pref_armor_production 1 pref_cycle_orbital 13
	var AtL|Call mining_count_var 3 resetpref_armor_production_ironfoundry 13
	var AtM|Call mining_count_var 2 resetpref_armor_production_fulcrum 13
	
	:pref_cycle_orbital
	var Ex|Jump pref_orbital_production 1 blank_return 13
	var AtL|Call mining_count_var 4 resetpref_armor_production_naniteassembly 13
	var AtM|Call mining_count_var 3 resetpref_armor_production_starport 13
	goto pref_cycle
	
	:resetpref_armor_production_barracks
	var Set pref_barracks 1 13
	var Set pref_captaincy 0 13
	return
	
	:resetpref_armor_production_captaincy
	var Set pref_barracks 0 13
	var Set pref_captaincy 1 13
	return
	
	:resetpref_armor_production_fulcrum
