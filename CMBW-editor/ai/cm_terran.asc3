	var Ex|Jump pref_raider 1 attack_handling_fast 13
	rand_j 160 attack_handling_fast
	
	:attack_handling_slow
	wait 240
	call attack_generic
	wait 360
	goto tLoopA
	
	:attack_handling_fast
	wait 180
	call attack_generic
	wait 240
	
	:tLoopA
