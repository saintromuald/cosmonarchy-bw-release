	return
	
	:select_personality_armor
	var Set pref_armor 1 13
	var Set pref_raider 0 13
	var Set pref_orbital 0 13
	var Set pref_scenario 0 13
	return
	
	:select_personality_raider
	var Set pref_armor 0 13
	var Set pref_raider 1 13
	var Set pref_orbital 0 13
	var Set pref_scenario 0 13
	return
	
	:select_personality_orbital
	var Set pref_armor 0 13
	var Set pref_raider 0 13
	var Set pref_orbital 1 13
	var Set pref_scenario 0 13
	return
	
	:select_personality_scenario
	var Set pref_armor 0 13
	var Set pref_raider 0 13
	var Set pref_orbital 0 13
	var Set pref_scenario 1 13
	call select_personality_scenario_check
	return
	
	:select_personality_scenario_lite
	var Set pref_scenario_lite 1 13
	dth 13 Set 0 cyprian blank
	return
	
	:select_personality_scenario_check
	dth 13 Ex 2 scanner_sweep select_personality_scenario_OneForTheFuture
#	dth 13 Ex 3 scanner_sweep select_personality_scenario_TheLostGods
	return
	
	:select_personality_scenario_OneForTheFuture
	dth 13 Ex_M 1 right_pit_door select_personality_scenario_OneForTheFuture_WallStreetWar
	dth 13 Ex_M 4 right_pit_door select_personality_scenario_OneForTheFuture_PastaMasta
	dth 13 Ex_M 7 right_pit_door select_personality_scenario_OneForTheFuture_FavoredFiction
	return
	
	:select_personality_scenario_OneForTheFuture_WallStreetWar
	wait 12
	var Set pref_armor 1 13
	var AtL|Wait mining_count_var 4 13
	var Set pref_armor 0 13
	var Set pref_orbital 1 13
	var AtM|Wait mining_count_var 3 13
	goto select_personality_scenario_OneForTheFuture_WallStreetWar
	
	:select_personality_scenario_OneForTheFuture_PastaMasta
	dth 13 Ex 5 t_tank_turret select_personality_scenario_OneForTheFuture_PastaMasta_TonyTron
	stop
	
	:select_personality_scenario_OneForTheFuture_PastaMasta_TonyTron
	var Set pref_orbital 1 13
	stop
	
	:select_personality_scenario_OneForTheFuture_FavoredFiction
	dth 13 Ex 5 t_tank_turret select_personality_scenario_OneForTheFuture_FavoredFiction_Ullen
	stop
	
	:select_personality_scenario_OneForTheFuture_FavoredFiction_Ullen
	var Set pref_armor 1 13
	stop
	
