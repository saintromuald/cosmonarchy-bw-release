	add_bld 255 cagrant_cesiant 1 20 98
	add_bld 255 nydus_cesiant 1 3 98
	wait 7200
	add_bld 255 cagrant_cesiant 1 20 98
	add_bld 255 nydus_cesiant 1 3 98
