	wait 240
	goto zLoopA
	
	:attack_handling_slow
	call attack_generic
	wait 440
	
	:zLoopA
	bring 13 AtL 8 hachirosk|caphrolosk|gathtelosk|larvosk_cesiant Loc.63 zLoopC
	bring 13 AtL 4 hachirosk|caphrolosk|gathtelosk|larvosk_cesiant Loc.63 zLoopB
	call attack_cycle_start
	wait 240
	goto zLoopA
	
	:zLoopB
	call attack_cycle_start
	wait 180
	rand_j 85 zLoopA
	wait 120
	goto zLoopA
	
	:zLoopC
	call attack_cycle_start
	wait 120
	goto zLoopA
	
	:attack_generic_worker_check
	bring 13 AtL 12 hachirosk|caphrolosk|gathtelosk|larvosk_cesiant Loc.63 blank_return
	call attack_conditions_zerg
	var Set can_worker_all_var 0 13
	return
	
	:attack_conditions_zerg
	var Ex|Jump has_tier_1_tech_node_var 1 blank_return 13
	multi attack_conditions_zerg_quazeth
	multi attack_conditions_zerg_hydrith
	multi attack_conditions_zerg_zorkiz
	var Ex|Wait has_tier_1_tech_node_var 1 13
	return
	
	:attack_conditions_zerg_quazeth
	wait 12
	bring 13 AtL 1 kalkiir_pond Loc.63 attack_conditions_zerg_success
	notowns quazeth_pool attack_conditions_zerg_quazeth
	goto attack_conditions_zerg_success
	
	:attack_conditions_zerg_hydrith
	wait 12
	bring 13 AtL 1 bactith_swamp Loc.63 attack_conditions_zerg_success
	notowns hydrith_den attack_conditions_zerg_hydrith
	goto attack_conditions_zerg_success
	
	:attack_conditions_zerg_zorkiz
	wait 12
	bring 13 AtL 1 ultrav_cavern Loc.63 attack_conditions_zerg_success
	notowns zorkiz_shroud attack_conditions_zerg_zorkiz
	goto attack_conditions_zerg_success
	
	:attack_conditions_zerg_success
	var Set has_tier_1_tech_node_var 1 13
	stop
	
	:attack_cycle_start
	var Ex|Wait can_attack_var 1 13
	time AtM 5760 Frames attack_cycle_cont
	bring 13 AtM 2 Group_Factories Loc.63 blank_return
	
	:attack_cycle_cont
	atk_do
	atk_c
	
	:attack_generic
	call attack_generic_worker_check
	call add_attack_wave
	atk_prep
	atk_do
	wait 500
	bring 13 AtL 60 zethrokor|vorvrokor|quazilisk|liiralisk|hydralisk|bactalisk|skithrokor|gorgrokor|kagralisk|izirokor|evigrilisk|mutalisk|vithrilisk|nathrokor|kalkalisk|zoryusthaleth|ultrokor|lakizilisk|matraleth|akistrokor|konvilisk|almaksalisk|keskathalor|alkajelisk|geszithalor|isthrathaleth|sovroleth|cohort|charlatan|axitrilisk|tarasque|empress|anticthon Loc.63 attack_expansion_check
	goto attack_cycle_fin
	
	:attack_expansion_check
	set_attacks 1
	target_expansion
	
	:attack_cycle_fin
	wait 120
	atk_c
	c_queues train zethrokor|vorvrokor|quazilisk|liiralisk|hydralisk|bactalisk|skithrokor|gorgrokor|kagralisk|izirokor|evigrilisk|mutalisk|vithrilisk|nathrokor|kalkalisk|zoryusthaleth|ultrokor|lakizilisk|matraleth|akistrokor|konvilisk|almaksalisk|keskathalor|alkajelisk|geszithalor|isthrathaleth|sovroleth|cohort|charlatan|axitrilisk|tarasque|empress|anticthon 13
	var Set can_worker_all_var 1 13
	return
	
	:attack_conditions
	wait 24
	bring 13 Ex 0 quazeth_pool|kalkiir_pond|hydrith_den|bactith_swamp|mutath_spire|tosvrol_haunt|zorkiz_shroud|ultrav_cavern|matravil_nest|almakis_antre|elthisth_mound|geszkath_grotto Loc.63 attack_conditions
	time AtM 5760 Frames blank_return
	bring 13 AtM 10 droleth Loc.63 attack_conditions
	bring 13 AtM 1 larvosk_cesiant|hachirosk|caphrolosk|gathtelosk Loc.63 attack_conditions
	res 13 AtL Any 500 blank_return
	var Ex|WF(360) under_attack_var 0 13
	return
	
	:add_attack_wave
	call attack_conditions
	var Ex|Jump pref_assault 1 add_attack_wave_assault 13
	var Ex|Jump pref_swarm 1 add_attack_wave_swarm 13
	var Ex|Jump pref_sunblot 1 add_attack_wave_sunblot 13
	
	:add_attack_wave_general
	rand_j 85 add_attack_wave_assault
	rand_j 128 add_attack_wave_swarm
	goto add_attack_wave_sunblot
	
	:add_attack_wave_assault
	call atk_hydrith_ranged
	call atk_izkag_ranged
	call atk_hydrith_air
	call atk_zorkiz_ranged
	call atk_axtoth_melee
	call atk_geszkath_siege
	call atk_zorkiz_melee
	call atk_quazeth_melee
	call atk_elthisth_siege
	call atk_matravil_ranged
	call atk_geszkath_air
	call atk_axtoth_ranged
	call atk_quazeth_ranged
	call atk_mutath_air
	call atk_matravil_special
	call atk_quazeth_air
	return
	
