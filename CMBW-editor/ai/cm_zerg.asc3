	:rich_boy_irol_iris
	wait 12
	bring 13 AtL 1 irol_iris|othstol_oviform Loc.63 blank
	res 13 AtM Gas 599 rich_boy_irol_iris
	p_need 1 irol_iris
	stop
	
	:rich_boy_othstol_oviform
	wait 12
	bring 13 AtL 1 othstol_oviform Loc.63 blank
	bring 13 AtL_W 1 irol_iris Loc.63 blank
	res 13 AtM Gas 1799 rich_boy_othstol_oviform
	p_need 1 othstol_oviform
	stop
	
	:tech_check
	wait 12
	bring 13 Ex 0 droleth|gosvileth Loc.63 tech_check
	notowns larva tech_check
	var Ex|Jump can_build_production_var 0 tech_check 13
	return
	
	:tech_wait
	wait 360
	var AtL|Jump mining_count_var 4 blank_return 13
	wait 360
	var AtL|Jump mining_count_var 3 blank_return 13
	wait 360
	var AtL|Jump mining_count_var 2 blank_return 13
	wait 360
	var AtL|Jump mining_count_var 1 blank_return 13
	wait 360
	return
	
	:tech_to_irol
	bring 13 AtL 1 irol_iris|othstol_oviform Loc.63 blank_return
	call tech_check
	multi need_irol
	bring 13 AtL_W 1 irol_iris Loc.63 blank
	call tech_wait
	return
	
	:tech_to_othstol
	bring 13 AtL 1 othstol_oviform Loc.63 blank_return
	call tech_check
	bring 13 Ex_C 0 irol_iris Loc.63 tech_to_irol
	call need_othstol
	bring 13 AtL_W 1 othstol_oviform Loc.63 blank
	call tech_wait
	return
	
	:tech_to_quazeth
	bring 13 AtL 1 quazeth_pool|kalkiir_pond Loc.63 blank_return
	call tech_check
	p_need 1 quazeth_pool
	bring 13 AtL_W 1 quazeth_pool Loc.63 blank
	call tech_wait
	return
	
	:tech_to_kalkiir
	bring 13 AtL 1 kalkiir_pond Loc.63 blank_return
	call tech_check
	bring 13 Ex_C 0 quazeth_pool Loc.63 tech_to_quazeth
	bring 13 Ex_C 0 irol_iris|othstol_oviform Loc.63 tech_to_irol
	p_need 1 kalkiir_pond
	bring 13 AtL_W 1 kalkiir_pond Loc.63 blank
	call tech_wait
	return
	
	:tech_to_mutath
	bring 13 AtL 1 mutath_spire|tosvrol_haunt Loc.63 blank_return
	call tech_check
	bring 13 Ex_C 0 othstol_oviform Loc.63 tech_to_irol
	p_need 1 mutath_spire
	bring 13 AtL_W 1 mutath_spire Loc.63 blank
	call tech_wait
	return
	
	:tech_to_tosvrol
	bring 13 AtL 1 tosvrol_haunt Loc.63 blank_return
	call tech_check
	bring 13 Ex_C 0 mutath_spire Loc.63 tech_to_mutath
	bring 13 Ex_C 0 othstol_oviform Loc.63 tech_to_othstol
	p_need 1 tosvrol_haunt
	bring 13 AtL_W 1 tosvrol_haunt Loc.63 blank
	call tech_wait
	return
	
	:tech_to_axtoth
	bring 13 AtL 1 axtoth_axis|begrozith_barrow Loc.63 blank_return
	call tech_check
	bring 13 Ex_C 0 othstol_oviform Loc.63 tech_to_othstol
	p_need 1 axtoth_axis
	bring 13 AtL_W 1 axtoth_axis Loc.63 blank
