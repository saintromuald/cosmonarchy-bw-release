	bring 13 AtM_C 15 othstoleth|iroleth|ovileth Loc.63 main_wait_600
	bring 13 AtM 3 larva Loc.63 main_transport_loop
	var Ex|WF(360) under_attack_var 0 13
	bring 13 Ex 0 irol_iris|othstol_oviform Loc.63 main_transport_ovileth
	bring 13 Ex 0 othstol_oviform Loc.63 main_transport_iroleth
