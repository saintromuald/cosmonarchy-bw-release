	:main_worker_safety
	wait 12
	var Ex|Jump can_worker_var 1 blank_return 13
	time AtM 5760 Frames main_worker_safety
	var AtL|WF(1080) can_worker_all_var 1 13
	return
	
	:main_worker_start
	multi worker_track
	
	:main_worker_loop
	wait 12
	call main_worker_safety
	var AtL|WF(540) can_worker_all_var 1 13
	local 255 AtL_W 1 hachirosk|caphrolosk|gathtelosk blank
	local 255 AtL_W 1 larva blank
	bring 13 AtL 5 hachirosk|caphrolosk|gathtelosk|larvosk_cesiant Loc.63 main_worker_loop_max
	bring 13 AtL 3 hachirosk|caphrolosk|gathtelosk|larvosk_cesiant Loc.63 main_worker_loop_med
	bring 13 AtL 2 hachirosk|caphrolosk|gathtelosk|larvosk_cesiant Loc.63 main_worker_loop_min
	time_jump 6 main_worker_loop_med
	goto main_worker_loop_early
	
