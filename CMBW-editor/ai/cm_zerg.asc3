	var Ex|Jump is_island_var 1 main_transport_loop 13
	wait 300
	var Ex|Jump pref_swarm 1 main_transport_loop 13
	wait 600
	var Ex|Jump pref_assault 1 main_transport_loop 13
	wait 600
	goto main_transport_loop
	
	:island_check
