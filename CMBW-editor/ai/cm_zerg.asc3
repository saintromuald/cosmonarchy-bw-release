	:build_bool
	# These are used no matter what!
	var Add can_worker_var 1 13
	var Add can_expand_var 1 13
	var Set can_attack_var 1 13
	var Set build_gas_var 1 13
	var Set build_done_var 1 13
	# These are not used if skip_building_var is true!
	var Set can_build_static_defense_var 1 13
	var Set can_queue_early_military_var 1 13
	var Set can_build_production_var 1 13
	return
	
	:build_order
	var Ex|Jump skip_building_var 1 build_order_skip 13
	var Ex|Call use_custom_timers_var 1 build_order_custom_timers 13
	var Ex|Jump pref_assault 1 build_order_assault 13
	var Ex|Jump pref_swarm 1 build_order_swarm 13
	var Ex|Jump pref_sunblot 1 build_order_sunblot 13
	goto build_order_general
	
	:build_order_skip
	var Ex|Jump debug_ai_messages_var 0 build_order_skip_main 13
	print Zerg<32>AI<32>skips<32>build<32>order!
	
	:build_order_custom_timers
	var Ex|Jump debug_ai_messages_var 0 build_order_skip_main_pre 13
	print Zerg<32>AI<32>uses<32>custom<32>timers<32>without<32>skipping<32>build<32>order!
	
	:build_order_skip_main_pre
	multi build_order_skip_main
	return
	
	:build_order_skip_main
	wait 3
	var Ex|Jump build_type_is_timing_var 1 build_order_skip_timing 13
	var Ex|Jump build_type_is_rush_var 1 build_order_skip_rush 13
	var Ex|Jump build_type_is_greed_var 1 build_order_skip_greed 13
	
	:build_order_skip_timing
	multi build_order_skip_timing_gas
	multi build_order_skip_timing_expand
	multi build_order_skip_timing_attack
	goto build_order_skip_Final
	
	:build_order_skip_timing_gas
	dth 13 AtL 1 mineral_field1 build_order_skip_custom_gas
	call main_wait_450
#	bld 1 excisant 105
	call main_wait_450
	var Add build_gas_var 1 13
	stop
	
	:build_order_skip_timing_expand
	dth 13 AtL 1 mineral_field2 build_order_skip_custom_expansions
	call main_wait_1200
	call main_wait_1200
	call main_wait_600
	var Add can_expand_var 1 13
	stop
	
	:build_order_skip_timing_attack
	dth 13 AtL 1 mineral_field3 build_order_skip_custom_attack
	call main_wait_1200
	call main_wait_900
	var Add can_attack_var 1 13
	stop
	
	:build_order_skip_rush
	multi build_order_skip_rush_gas
	multi build_order_skip_rush_expand
	multi build_order_skip_rush_attack
	goto build_order_skip_Final
	
	:build_order_skip_rush_gas
	call main_wait_450
	var Add build_gas_var 1 13
	stop
	
	:build_order_skip_rush_expand
	call main_wait_450
	call main_wait_1500
	call main_wait_2400
	var Add can_expand_var 1 13
	stop
	
	:build_order_skip_rush_attack
	call main_wait_450
	call main_wait_1500
	var Add can_attack_var 1 13
	stop
	
	:build_order_skip_greed
	multi build_order_skip_greed_gas
	multi build_order_skip_greed_expand
	multi build_order_skip_greed_attack
	goto build_order_skip_Final
	
	:build_order_skip_greed_gas
	call main_wait_900
#	bld 1 excisant 105
	call main_wait_900
	var Add build_gas_var 1 13
	
	:build_order_skip_greed_expand
	call main_wait_450
	var Add can_expand_var 1 13
	stop
	
	:build_order_skip_greed_attack
	call main_wait_1800
	call main_wait_2400
	var Add can_attack_var 1 13
	stop
	
	:build_order_skip_custom_gas
	var Ex|Jump debug_ai_messages_var 0 build_order_skip_custom_gas_loop 13
	print Zerg<32>AI<32>custom<32>gas<32>timer<32>started...
	
	:build_order_skip_custom_gas_loop
	wait 24
	dth 13 Sub 1 mineral_field1 blank
	dth 13 AtL 1 mineral_field1 build_order_skip_custom_gas_loop
	var Set build_gas_var 1 13
	var Ex|Jump debug_ai_messages_var 0 blank 13
	print Zerg<32>AI<32>gets<32>gas<32>at<32>a<32>custom<32>time!
	stop
	
	:build_order_skip_custom_expansions
	var Ex|Jump debug_ai_messages_var 0 build_order_skip_custom_expansions_loop 13
	print Zerg<32>AI<32>custom<32>expansion<32>timer<32>started...
	
	:build_order_skip_custom_expansions_loop
	wait 24
	dth 13 Sub 1 mineral_field2 blank
	dth 13 AtL 1 mineral_field2 build_order_skip_custom_expansions_loop
	var Add can_expand_var 1 13
	var Ex|Jump debug_ai_messages_var 0 blank 13
	print Zerg<32>AI<32>expands<32>at<32>a<32>custom<32>time!
	stop
	
	:build_order_skip_custom_attack
	var Ex|Jump debug_ai_messages_var 0 build_order_skip_custom_attack_loop 13
	print Zerg<32>AI<32>custom<32>attack<32>timer<32>started...
	
	:build_order_skip_custom_attack_loop
	wait 24
	dth 13 Sub 1 mineral_field3 blank
	dth 13 AtL 1 mineral_field3 build_order_skip_custom_attack_loop
	var Set can_attack_var 1 13
	var Ex|Jump debug_ai_messages_var 0 blank 13
	print Zerg<32>AI<32>attacks<32>at<32>a<32>custom<32>time!
	stop
	
	:build_order_skip_Final
	wait 7200
	call build_bool
	stop
	
	:build_order_general
	dth 13 AtL 1 dark_swarm_unit build_order_general_select
	var Ex|Jump build_type_is_timing_var 1 build_order_general_type_timing 13
	var Ex|Jump build_type_is_rush_var 1 build_order_general_type_rush 13
	var Ex|Jump build_type_is_greed_var 1 build_order_general_type_greed 13
	
	:build_order_general_type_timing
	# 4 timings
	rand_j 64 build_order_general_type_timing_1
	rand_j 85 build_order_general_type_timing_2
	rand_j 128 build_order_general_type_timing_3
	goto build_order_general_type_timing_2
	
	:build_order_general_type_timing_1
	dth 13 Set 2 dark_swarm_unit blank
	goto build_order_general_select
	
	:build_order_general_type_timing_2
	dth 13 Set 3 dark_swarm_unit blank
	goto build_order_general_select
	
	:build_order_general_type_timing_3
	dth 13 Set 5 dark_swarm_unit blank
	goto build_order_general_select
	
	:build_order_general_type_timing_4
	dth 13 Set 6 dark_swarm_unit blank
	goto build_order_general_select
	
	:build_order_general_type_rush
	# 1 rush
	goto build_order_general_type_rush_1
	
	:build_order_general_type_rush_1
	dth 13 Set 4 dark_swarm_unit blank
	goto build_order_general_select
	
	:build_order_general_type_greed
	# 1 greed
	goto build_order_general_type_greed_1
	
	:build_order_general_type_greed_1
	dth 13 Set 1 dark_swarm_unit blank
	goto build_order_general_select
	
	:build_order_general_select
	dth 13 Ex 1 dark_swarm_unit build_general_SleepingGiant
	dth 13 Ex 2 dark_swarm_unit build_general_ShriekingSwarm
	dth 13 Ex 3 dark_swarm_unit build_general_Subjugation
	dth 13 Ex 4 dark_swarm_unit build_general_BeforeTheStorm
	dth 13 Ex 5 dark_swarm_unit build_general_TimeAfterTime
	dth 13 Ex 6 dark_swarm_unit build_general_ConstrainedCoil
	
	:build_general_SleepingGiant
	dth 13 Ex 0 start_location build_general_SleepingGiant_Main
	print Zerg<32>General<32>greed<32>1:<32>Sleeping<32>Giant
	
	:build_general_SleepingGiant_Main
	var Ex|Call pref_quazeth 0 buildpref_quazeth_zethrokor 13
	var Ex|Call pref_geszkath 0 buildpref_ultrav_ultrokor 13
	var Ex|Call pref_hydrok 0 buildpref_hydrith_hydralisk 13
	var Ex|Call pref_liivral 0 buildpref_kalkiir_kalkalisk 13
	var Ex|Call pref_vithrath 0 buildpref_zorkiz_zoryusthaleth 13
	var Ex|Call pref_muthrok 0 buildpref_mutath_mutalisk 13
	var Ex|Call pref_geszkath 0 buildpref_geszkath_geszithalor 13
	var Ex|Call pref_matravil 0 buildpref_matravil_matraleth 13
	var Ex|Call pref_transport 0 buildpref_transport_ovileth 13
	var Ex|Call pref_production 0 buildpref_production_larvoskcesiant 13
	call main_wait_1050
    var Sub can_worker_var 1 13
    multi expansion_loop_toggle
    call main_wait_600
    var Add can_worker_var 1 13
    wait 60
    p_need 1 quazeth_pool
    call main_wait_900
    var Set build_gas_var 1 13
    call main_wait_600
	var Set can_build_static_defense_var 1 13
    bring 13 AtL_W 15 droleth Loc.63 blank
	call main_wait_300
	var Set build_gas_var 1 13
	call main_wait_300
    multi need_irol
    call main_wait_300
    var Set can_attack_var 1 13
    call main_wait_150
	call wait_for_IrolIris
	bld 1 caphrolosk 98
	call main_wait_750
    bld 2 hachirosk 98
    call main_wait_750
	p_need 1 zorkiz_shroud
	call main_wait_600
	multi build_general_SleepingGiant_Morph
    call main_wait_600
    multi need_othstol
    call main_wait_1200
	bld 1 gathtelosk 99
	call main_wait_300
    multi production_cycle
    goto build_general_fin
	
	:build_general_SleepingGiant_Morph
	call wait_for_IrolIris
	call wait_for_QuazethPool
	p_need 1 kalkiir_pond
	p_need 1 matravil_nest
	call main_wait_900
	p_need 1 mutath_spire
	call wait_for_OthstolOviform
	p_need 1 tosvrol_haunt
	stop
	
